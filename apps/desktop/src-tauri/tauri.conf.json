{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astro Agent",
  "version": "0.1.0",
  "identifier": "com.astroagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Astro Agent",
        "width": 1100,
        "height": 800,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#dbeafe"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**/*",
            "$HOME/.astro/**/*",
            "$APPDATA/**/*",
            "$RESOURCE/**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/**/*": "./",
      "../../../evolution-dspy/pyproject.toml": "evolution-dspy/pyproject.toml",
      "../../../evolution-dspy/README.md": "evolution-dspy/README.md",
      "../../../evolution-dspy/evolution_dspy/__init__.py": "evolution-dspy/evolution_dspy/__init__.py",
      "../../../evolution-dspy/evolution_dspy/__main__.py": "evolution-dspy/evolution_dspy/__main__.py",
      "../../../evolution-dspy/evolution_dspy/metric.py": "evolution-dspy/evolution_dspy/metric.py",
      "../../../evolution-dspy/evolution_dspy/program.py": "evolution-dspy/evolution_dspy/program.py"
    },
    "macOS": {
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 372
        },
        "appPosition": {
          "x": 170,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 210
        }
      }
    }
  }
}
