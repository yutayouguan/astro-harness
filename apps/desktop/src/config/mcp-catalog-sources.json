{
  "version": 1,
  "output": "src/config/mcp-community-catalog.json",
  "sources": [
    {
      "id": "mcpservers.org",
      "enabled": true,
      "baseUrl": "https://mcpservers.org",
      "locale": "zh-CN",
      "requestDelayMs": 500,
      "timeoutMs": 30000,
      "userAgent": "Astro-Agent-MCP-Catalog/1.0",
      "feeds": [
        {
          "path": "/zh-CN/",
          "collections": ["featured", "latest"],
          "featuredCollections": ["featured"],
          "maxPages": 1
        },
        {
          "path": "/zh-CN/official",
          "collections": ["servers"],
          "forceOfficial": true,
          "maxPages": 3
        },
        {
          "path": "/zh-CN/remote-mcp-servers",
          "collections": ["featuredServers", "moreServers"],
          "maxPages": 1
        }
      ]
    }
  ],
  "categoryMap": {
    "productivity": "productivity",
    "development": "development",
    "version-control": "development",
    "file-system": "development",
    "finance": "finance",
    "search": "research",
    "web-scraping": "research",
    "database": "analytics",
    "communication": "communication",
    "design": "other",
    "cloud-service": "other",
    "cloud-storage": "other",
    "marketing": "other",
    "memory": "other",
    "other": "other"
  },
  "iconAliases": {
    "atlassian-mcp-server": "atlassian",
    "blender-mcp": "blender",
    "exa-labs/exa-mcp-server": "exa",
    "github-mcp-server": "github",
    "playwright-mcp-server": "playwright",
    "supabase-mcp-server": "supabase"
  }
}
